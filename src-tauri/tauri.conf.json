{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "vemry",
  "identifier": "dev.vemry.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "vemry",
        "width": 1280,
        "height": 820,
        "minWidth": 764,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' blob: data: https: http: vemry-asset:; font-src 'self' data:; connect-src ipc: http://ipc.localhost; media-src 'self' blob:; frame-src blob:"
    }
  },
  "bundle": {
    "active": true,
    "category": "Productivity",
    "shortDescription": "A local-first AI study workbench",
    "longDescription": "vemry is a local-first AI study workbench. Papers, pages and PDFs come in as plain Markdown files on your own disk; you read, translate, question and card them with an AI whose writes stop at a diff you approve, and which never sees what you mark private. No account, no telemetry, no sync service.",
    "targets": ["app", "dmg", "nsis", "appimage", "deb", "rpm"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "headerImage": "icons/nsis-header.bmp",
        "sidebarImage": "icons/nsis-sidebar.bmp",
        "languages": ["SimpChinese", "English"]
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEY0Qzk2QzVFNzhBQzBCMUUKUldRZUM2eDRYbXpKOUhzVitwdWlBQVlJVVM4Wk9VcDg3S2xvL2cyMVFNQmFDQ3VXVWxURUtiRzUK",
      "endpoints": [
        "https://github.com/pangyexing/vemry/releases/latest/download/latest.json"
      ]
    }
  }
}
