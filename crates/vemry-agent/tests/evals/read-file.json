{
  "name": "read-file",
  "vault": {
    "Notes.md": "# Notes\n",
    "data/latency.csv": "run,p95_ms\n1,12\n2,11\n3,13\n",
    "secret/keys.txt": "TOPSECRET\n",
    ".vemry/privacy": "secret/\n"
  },
  "turns": [
    {
      "user": "把 data 里的延迟数据读出来",
      "script": [
        [ { "tool": { "id": "c1", "name": "list_files", "args": { "folder": "data" } } } ],
        [ { "tool": { "id": "c2", "name": "read_file", "args": { "path": "data/latency.csv" } } }, { "tool": { "id": "c3", "name": "read_file", "args": { "path": "secret/keys.txt" } } } ],
        [ { "text": "三次运行 p95 分别 12、11、13 ms。" } ]
      ]
    }
  ],
  "expect": {
    "no_writes": true,
    "tool_output_contains": [ { "id": "c1", "text": "data/latency.csv\tother\t" }, { "id": "c2", "text": "run,p95_ms" }, { "id": "c3", "text": "ERROR: " } ]
  }
}
